# Salin menjadi .env.local dan sesuaikan bila perlu.
#
# API_BASE_URL dipakai HANYA di sisi server Next.js (route handler / server
# component). Token tidak pernah diberikan ke browser, sehingga URL API tidak
# perlu prefix NEXT_PUBLIC_ dan tidak boleh diakses dari client component.
API_BASE_URL=http://127.0.0.1:8000

# Nama cookie HttpOnly yang menyimpan token Sanctum.
SESSION_COOKIE_NAME=parangtritis_token

# Flag Secure cookie sesi. Kosongkan agar mengikuti NODE_ENV (true di produksi).
# Set false hanya untuk uji lokal dengan `next start` di atas HTTP.
# SESSION_COOKIE_SECURE=false
